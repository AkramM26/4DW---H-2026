@model IEnumerable<TP1.Models.Branches.BranchItem>

@{
    ViewData["Title"] = "List";
}
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

@if (TempData["Erreur"] != null)
{
    <div class="alert alert-danger">
        @TempData["Erreur"]
    </div>
}
<h1>List</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Status)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { branchId = item.BranchId }) |
                    @Html.ActionLink("Liste de voitures", "List", "Car", new { branchId = item.BranchId }) |
                    @Html.ActionLink("Delete", "Delete", new { branchId = item.BranchId })
            </tr>
        }
    </tbody>
</table>
