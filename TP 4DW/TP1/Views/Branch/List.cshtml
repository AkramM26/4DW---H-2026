@model IEnumerable<TP1.Models.Branches.BranchItem>

@{
    ViewData["Title"] = "Gestion des Succursales";
}

<div class="container mt-4 mb-5">
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Erreur"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @TempData["Erreur"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 mb-4 bg-primary text-white">
        <div class="card-body d-flex justify-content-between align-items-center py-4 px-4">
            <div>
                <h1 class="fw-bold mb-0 text-white"><i class="bi bi-buildings me-2"></i>Réseau de Succursales</h1>
                <p class="mb-0 opacity-75">Gérez vos points de service et surveillez l'état de la flotte en temps réel.</p>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-light btn-lg shadow-sm px-4 fw-bold text-primary">
                    <i class="bi bi-plus-lg me-1"></i> Ajouter une succursale
                </a>
            }
        </div>
    </div>

    <div class="card shadow border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark py-3">
                        <tr>
                            <th class="ps-4 py-3">Statut</th>
                            <th>Nom de la succursale</th>
                            <th class="text-center">Véhicules Actifs</th>
                            <th class="text-center">Désactivés</th>
                            <th class="text-end pe-4">Actions de gestion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    @if (item.Status)
                                    {
                                        <span class="badge rounded-pill bg-success px-3">
                                            <i class="bi bi-check-circle me-1 small"></i> Ouverte
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary px-3">
                                            <i class="bi bi-lock-fill me-1 small"></i> Fermée
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold fs-5 text-dark">@item.Name</div>
                                    <small class="text-muted"><i class="bi bi-geo-alt me-1"></i> Point de service officiel</small>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-success-subtle text-success border border-success px-3 py-2 fs-6 fw-normal" style="min-width: 60px;">
                                        @item.ActiveCarsCount <i class="bi bi-car-front-fill ms-1"></i>
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-3 py-2 fs-6 fw-normal" style="min-width: 60px;">
                                        @item.DisabledCarsCount <i class="bi bi-tools ms-1"></i>
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="List" asp-controller="Car" asp-route-branchId="@item.BranchId" class="btn btn-primary shadow-sm" style="min-width: 110px;">
                                            <i class="bi bi-search me-1"></i> Inventaire
                                        </a>

                                        <a asp-action="Edit" asp-route-branchId="@item.BranchId" class="btn btn-outline-secondary shadow-sm" style="min-width: 85px;">
                                            <i class="bi bi-pencil me-1"></i> Éditer
                                        </a>

                                        <a asp-action="Delete" asp-route-branchId="@item.BranchId" class="btn btn-outline-danger shadow-sm" style="min-width: 95px;"
                                           onclick="return confirm('Attention : Supprimer cette succursale supprimera tout son historique. Confirmer ?');">
                                            <i class="bi bi-trash me-1"></i> Retirer
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4 text-center">
        <p class="text-muted small mb-2">Besoin d'une vue d'ensemble ?</p>
        <a asp-controller="Car" asp-action="ListAll" class="btn btn-outline-dark px-4 rounded-pill shadow-sm">
            <i class="bi bi-globe2 me-1"></i> Consulter l'inventaire global complet
        </a>
    </div>
</div>