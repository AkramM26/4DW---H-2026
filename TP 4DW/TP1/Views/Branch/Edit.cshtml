@model TP1.Models.Branches.BranchEdit

@{
    ViewData["Title"] = "Modifier la succursale";
}
<div asp-validation-summary="All" class="text-danger"></div>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Modifier : @Model.Name</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold">Nom de la succursale</label>
                            <input asp-for="Name" class="form-control form-control-lg" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-4 p-3 bg-light rounded border">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="Status" id="statusSwitch">
                                    <label class="form-check-label fw-bold" for="statusSwitch">
                                        Succursale active
                                    </label>
                                </div>
                                <small class="text-muted">Si vous désactivez cette succursale, elle n'apparaîtra plus comme option pour les nouveaux véhicules.</small>
                            </div>

                            <hr />

                            <div class="d-flex justify-content-between align-items-center mt-4">
                                <a asp-action="List" class="btn btn-outline-secondary">
                                    Annuler
                                </a>
                                <button type="submit" class="btn btn-success px-5 shadow-sm">
                                    <i class="bi bi-save me-1"></i> Enregistrer
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>