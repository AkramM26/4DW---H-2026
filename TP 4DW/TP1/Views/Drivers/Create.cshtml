@model TP1.Models.Drivers.DriverCreate

@{
    ViewData["Title"] = "Nouveau Conducteur";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-person-plus-fill me-2"></i>Enregistrement d'un nouveau conducteur</h4>
                </div>
                
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label fw-bold">Prénom</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                    <input asp-for="FirstName" class="form-control" placeholder="Ex: Gabriel" />
                                </div>
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label fw-bold">Nom de famille</label>
                                <input asp-for="LastName" class="form-control" placeholder="Ex: Durette" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-3 text-muted" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="EmailAdress" class="form-label fw-bold">Adresse Courriel</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="EmailAdress" class="form-control" placeholder="nom@exemple.com" />
                                </div>
                                <span asp-validation-for="EmailAdress" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label fw-bold">Téléphone</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="PhoneNumber" class="form-control" placeholder="(450) 000-0000" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DriverLicenceNumber" class="form-label fw-bold">Numéro de permis de conduire</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-primary text-white"><i class="bi bi-card-list"></i></span>
                                <input asp-for="DriverLicenceNumber" class="form-control" placeholder="D0000-000000-00" />
                            </div>
                            <span asp-validation-for="DriverLicenceNumber" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                            <a asp-action="Index" class="btn btn-link text-secondary text-decoration-none">
                                <i class="bi bi-arrow-left"></i> Annuler
                            </a>
                            <button type="submit" class="btn btn-primary px-5 shadow">
                                <i class="bi bi-check-lg me-1"></i> Créer le profil
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}