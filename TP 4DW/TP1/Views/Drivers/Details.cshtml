@model LocationManagerCore.Domains.Driver

@{
    ViewData["Title"] = $"Détails - {Model.FirstName} {Model.LastName}";
    var erreur = ViewData["Erreur"] as string;
}

<div class="container mt-4">
    @if (!string.IsNullOrEmpty(erreur))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-octagon-fill me-2"></i> @erreur
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-person-badge me-2"></i>Profil Conducteur</h4>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="display-1 text-secondary"><i class="bi bi-person-circle"></i></div>
                        <h3 class="fw-bold">@Model.FirstName @Model.LastName</h3>
                        <span class="badge bg-light text-muted border">ID: @Model.Id.ToString().Substring(0, 8)...</span>
                    </div>

                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex align-items-center py-3">
                            <i class="bi bi-envelope text-primary fs-4 me-3"></i>
                            <div>
                                <small class="text-muted d-block">Courriel</small>
                                <strong>@Model.EmailAdress</strong>
                            </div>
                        </li>
                        <li class="list-group-item d-flex align-items-center py-3">
                            <i class="bi bi-telephone text-primary fs-4 me-3"></i>
                            <div>
                                <small class="text-muted d-block">Téléphone</small>
                                <strong>@Model.PhoneNumber</strong>
                            </div>
                        </li>
                        <li class="list-group-item d-flex align-items-center py-3">
                            <i class="bi bi-card-checklist text-primary fs-4 me-3"></i>
                            <div>
                                <small class="text-muted d-block">No. Permis de conduire</small>
                                <strong class="text-uppercase">@Model.DriverLicenceNumber</strong>
                            </div>
                        </li>
                    </ul>
                </div>
                <div class="card-footer bg-white border-top-0 d-flex justify-content-between py-3">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left"></i> Retour
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm px-4">
                        <i class="bi bi-pencil-square me-1"></i> Modifier le profil
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-car-front-fill me-2"></i>Dernière Location</h4>
                </div>
                <div class="card-body p-4">
                    @if (Model.Locations != null && Model.Locations.Any())
                    {
                        var loc = Model.Locations.OrderByDescending(l => l.Opening).First();
                        
                        <div class="p-3 bg-light rounded border mb-4 text-center">
                            <h5 class="text-muted mb-1">Véhicule assigné</h5>
                            <h2 class="text-primary fw-bold">@loc.Car?.Nickname</h2>
                            <span class="badge bg-white text-dark border">@loc.Car?.CarBrand @loc.Car?.CarModel</span>
                        </div>

                        <div class="row g-4">
                            <div class="col-6">
                                <label class="text-muted small d-block">Date de départ</label>
                                <strong><i class="bi bi-calendar-check me-1"></i> @loc.Opening.ToString("d MMMM yyyy")</strong>
                            </div>
                            <div class="col-6">
                                <label class="text-muted small d-block">Retour prévu</label>
                                <strong><i class="bi bi-calendar-event me-1"></i> @loc.PlanedClosing.ToString("d MMMM yyyy")</strong>
                            </div>
                            <div class="col-12">
                                <label class="text-muted small d-block">Statut du contrat</label>
                                @if (loc.OfficialClosing == null)
                                {
                                    <div class="alert alert-info border-0 mt-2 mb-0">
                                        <i class="bi bi-info-circle-fill me-2"></i><strong>Location présentement active</strong>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-secondary border-0 mt-2 mb-0">
                                        <i class="bi bi-check-all me-2"></i>Contrat terminé le @loc.OfficialClosing?.ToString("d MMMM yyyy")
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-clipboard-x text-muted display-4"></i>
                            <p class="mt-3 text-muted">Ce conducteur n'a aucune location enregistrée.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>