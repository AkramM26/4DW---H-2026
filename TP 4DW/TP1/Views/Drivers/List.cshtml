@model IEnumerable<LocationManagerCore.Domains.Driver>

@{
    ViewData["Title"] = "List";
}

@{
    var erreur = ViewData["Erreur"] as string;
}
@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

@if (TempData["Erreur"] != null)
{
    <div class="alert alert-danger">
        @TempData["Erreur"]
    </div>
}

@if (!string.IsNullOrEmpty(erreur))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @erreur
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Prénom</th>
            <th>Nom</th>
            <th>Date de location</th>
            <th>Voiture louée</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            var loc = item.Locations?.FirstOrDefault();

            <tr>
                <td>@item.FirstName</td>
                <td>@item.LastName</td>
                <td>@loc?.Opening.ToShortDateString()</td>
                <td>@loc?.Car?.Nickname</td>

                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                    @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.Id })
                </td>
            </tr>
        }
    </tbody>
</table>