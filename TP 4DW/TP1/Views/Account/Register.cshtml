@model TP1.Models.Account.AccountRegistration

@{
    ViewData["Title"] = "Inscription";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white text-center py-3">
                    <h3 class="mb-0">
                        <i class="bi bi-person-plus-fill me-2"></i>Créer un compte
                    </h3>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label"></label>
                            <input asp-for="UserName" class="form-control" placeholder="Nom d'utilisateur" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Nom complet" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EmailAddress" class="form-label"></label>
                            <input asp-for="EmailAddress" class="form-control" placeholder="email@exemple.com" />
                            <span asp-validation-for="EmailAddress" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mot de passe</label>
                            <div class="input-group">
                                <input asp-for="Password" type="text" class="form-control" id="passwordInput" placeholder="Mot de passe" />
                                <input asp-for="ConfirmPassword" type="hidden" id="confirmPasswordInput" />
                                <button type="button" class="btn btn-outline-secondary" onclick="generatePassword()">
                                    <i class="bi bi-shuffle me-1"></i> Générer
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Role" class="form-label"></label>
                            <select asp-for="Role" class="form-select shadow-sm" id="roleSelect"
                                    onchange="toggleBranch()">
                                <option value="@TP1.Constantes.Roles.ADMIN">Administrateur</option>
                                <option value="@TP1.Constantes.Roles.MANAGER">Gérant</option>
                                <option value="@TP1.Constantes.Roles.CLERK">Commis</option>
                                <option value="@TP1.Constantes.Roles.USER">Utilisateur</option>
                            </select>
                        </div>

                        <div class="mb-4" id="branchDiv" style="display:none;">
                            <label asp-for="BranchId" class="form-label">Succursale associée <span class="text-danger">*</span></label>
                            <select asp-for="BranchId" class="form-select shadow-sm">
                                <option value="">-- Sélectionner une succursale --</option>
                                @if (ViewBag.Branches != null)
                                {
                                    foreach (var branch in ViewBag.Branches)
                                    {
                                        <option value="@branch.BranchId">@branch.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="BranchId" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success shadow-sm">
                                <i class="bi bi-check-circle me-1"></i> S'inscrire
                            </button>
                        </div>
                    </form>
                </div>

                <div class="card-footer text-center bg-light">
                    <a asp-action="Index" class="text-decoration-none">
                        <i class="bi bi-arrow-left"></i> Retour
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function generatePassword() {
            const upper = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
            const lower = 'abcdefghijklmnopqrstuvwxyz';
            const digits = '0123456789';
            const special = '!@@#$%';
            const all = upper + lower + digits + special;

            let pwd = [
                upper[Math.floor(Math.random() * upper.length)],
                lower[Math.floor(Math.random() * lower.length)],
                digits[Math.floor(Math.random() * digits.length)],
                special[Math.floor(Math.random() * special.length)]
            ];
            for (let i = 4; i < 10; i++)
                pwd.push(all[Math.floor(Math.random() * all.length)]);

            // Mélanger
            pwd = pwd.sort(() => Math.random() - 0.5).join('');

            document.getElementById('passwordInput').value = pwd;
            document.getElementById('confirmPasswordInput').value = pwd;
        }

        function toggleBranch() {
            var role = document.getElementById('roleSelect').value;
            var branchDiv = document.getElementById('branchDiv');
            if (role === '@TP1.Constantes.Roles.MANAGER' || role === '@TP1.Constantes.Roles.CLERK') {
                branchDiv.style.display = '';
            } else {
                branchDiv.style.display = 'none';
            }
        }
        // Run on page load to handle model re-display after validation error
        toggleBranch();
    </script>
}