@model IEnumerable<LocationManagerCore.Domains.AppUser>

@{
    ViewData["Title"] = "RegisteredList";
}

<h1>RegisteredList</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.UserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EmailAddress)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.UserName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Email)
                </td>
                <td>
                    @Html.ActionLink("Details", "Details", new { name = item.UserName }) |
                    @Html.ActionLink("Delete", "Delete", new { name = item.UserName })
                </td>
            </tr>
        }
    </tbody>
</table>
