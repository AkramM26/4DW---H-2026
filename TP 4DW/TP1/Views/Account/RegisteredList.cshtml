@model IEnumerable<LocationManagerCore.Domains.AppUser>

@{
    ViewData["Title"] = "Utilisateurs enregistrés";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0 text-dark">
                <i class="bi bi-people-fill me-2"></i>Utilisateurs
            </h2>
            <p class="text-muted mb-0">Liste des comptes enregistrés</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus me-1"></i> Nouvel utilisateur
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="ps-4">@Html.DisplayNameFor(model => model.UserName)</th>
                            <th>@Html.DisplayNameFor(model => model.EmailAddress)</th>
                            <th class="text-center px-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-primary">
                                    @item.UserName
                                </td>
                                <td>
                                    <span class="text-muted">@item.Email</span>
                                </td>
                                <td class="text-center px-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Details"
                                           asp-route-name="@item.UserName"
                                           class="btn btn-sm btn-info text-white shadow-sm d-flex align-items-center justify-content-center"
                                           style="min-width: 75px;">
                                            <i class="bi bi-eye me-1"></i> Voir
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-name="@item.UserName"
                                           class="btn btn-sm btn-danger shadow-sm d-flex align-items-center justify-content-center"
                                           style="min-width: 75px;">
                                            <i class="bi bi-trash me-1"></i> Supprimer
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>