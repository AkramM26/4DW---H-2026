@model TP1.Models.Locations.LocationCreate

@{
    ViewData["Title"] = "Nouvelle location";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm border-0">

                <div class="card-header bg-secondary text-white py-3">
                    <h3 class="mb-0">
                        <i class="bi bi-journal-plus me-2"></i>Nouvelle location
                    </h3>
                </div>

                <div class="card-body p-4">

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="CarId" />
                        <input type="hidden" asp-for="BranchId" />

                        <div class="row">
                            <div class="col-md-6 border-end">
                                <h5 class="text-secondary mb-3 border-bottom pb-2">Général</h5>

                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" asp-for="Status" />
                                    <label class="form-check-label" asp-for="Status"></label>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Opening" class="form-label"></label>
                                    <div class="input-group">
                                        <input asp-for="Opening" type="datetime-local" class="form-control"
                                               id="openingInput" />
                                        <button type="button" class="btn btn-outline-secondary"
                                                onclick="document.getElementById('openingInput').value = new Date(new Date().getTime() - new Date().getTimezoneOffset()*60000).toISOString().slice(0,16)">
                                            <i class="bi bi-clock me-1"></i>Maintenant
                                        </button>
                                    </div>
                                    <span asp-validation-for="Opening" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="PlanedClosing" class="form-label"></label>
                                    <input asp-for="PlanedClosing" type="datetime-local" class="form-control" />
                                    <span asp-validation-for="PlanedClosing" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6 ps-4">
                                <h5 class="text-secondary mb-3 border-bottom pb-2">Conducteur</h5>

                                <div class="mb-3">
                                    <label asp-for="DriverLastname" class="form-label"></label>
                                    <input asp-for="DriverLastname" class="form-control" />
                                    <span asp-validation-for="DriverLastname" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="DriverFirstName" class="form-label"></label>
                                    <input asp-for="DriverFirstName" class="form-control" />
                                    <span asp-validation-for="DriverFirstName" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="DriverEmailAddress" class="form-label"></label>
                                    <input asp-for="DriverEmailAddress" class="form-control" />
                                    <span asp-validation-for="DriverEmailAddress" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="PhoneNumber" class="form-label"></label>
                                    <input asp-for="PhoneNumber" class="form-control" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="DriverLicenceNumber" class="form-label"></label>
                                    <input asp-for="DriverLicenceNumber" class="form-control" />
                                    <span asp-validation-for="DriverLicenceNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="row">
                            <div class="col-md-12">
                                <h5 class="text-secondary mb-3 border-bottom pb-2">Adresse</h5>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label asp-for="StreetNumber" class="form-label"></label>
                                        <input asp-for="StreetNumber" class="form-control" />
                                        <span asp-validation-for="StreetNumber" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-8 mb-3">
                                        <label asp-for="StreetName" class="form-label"></label>
                                        <input asp-for="StreetName" class="form-control" />
                                        <span asp-validation-for="StreetName" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label asp-for="CityName" class="form-label"></label>
                                        <input asp-for="CityName" class="form-control" />
                                        <span asp-validation-for="CityName" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label asp-for="Province" class="form-label"></label>
                                        <input asp-for="Province" class="form-control" />
                                    </div>

                                    <div class="col-md-4 mb-3">
                                        <label asp-for="Country" class="form-label"></label>
                                        <input asp-for="Country" class="form-control" />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="PostalCode" class="form-label"></label>
                                    <input asp-for="PostalCode" class="form-control" />
                                    <span asp-validation-for="PostalCode" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="mb-3">
                            <label asp-for="InitialNote" class="form-label text-secondary">
                                <i class="bi bi-sticky me-1"></i> Note initiale <span class="text-muted fw-normal">(optionnel)</span>
                            </label>
                            <textarea asp-for="InitialNote" class="form-control" rows="3"
                                      placeholder="Observations à l'ouverture de la location..."></textarea>
                            <span asp-validation-for="InitialNote" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Retour
                            </a>
                            <button type="submit" class="btn btn-secondary px-5">
                                <i class="bi bi-check-circle me-1"></i> Créer
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}