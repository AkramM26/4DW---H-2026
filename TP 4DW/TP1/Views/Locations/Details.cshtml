@using TP1.Models.Locations
@model LocationCreate

@{
    ViewData["Title"] = "Dossier de Location";
    var erreur = TempData["Erreur"] as string;
}

<div class="container mt-4 mb-5">
    @if (!string.IsNullOrEmpty(erreur))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @erreur
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-end mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold text-dark mb-0"><i class="bi bi-file-earmark-text-fill me-2 text-primary"></i>Dossier de Location</h2>
            <p class="text-muted mb-0">Référence interne : <span class="font-monospace">LOC-@Model.Opening.Ticks.ToString().Substring(10)</span></p>
        </div>
        <div class="text-end">
            @if (Model.OfficialClosing == null)
            {
                <span class="badge rounded-pill bg-success px-4 py-2 fs-6 shadow-sm">
                    <i class="bi bi-unlock-fill me-1"></i> DOSSIER OUVERT
                </span>
            }
            else
            {
                <span class="badge rounded-pill bg-secondary px-4 py-2 fs-6 shadow-sm">
                    <i class="bi bi-lock-fill me-1"></i> DOSSIER FERMÉ
                </span>
            }
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-person-bounding-box me-2"></i>Informations Conducteur</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="display-6 text-primary me-3"><i class="bi bi-person-vcard"></i></div>
                        <div>
                            <h4 class="mb-0 fw-bold">@Model.Driver.FirstName @Model.Driver.LastName</h4>
                            <small class="text-muted">No Permis : @Model.Driver.DriverLicenceNumber</small>
                        </div>
                    </div>
                    <hr />
                    <a asp-controller="Drivers" asp-action="Details" asp-route-id="@Model.Driver.Id" class="btn btn-sm btn-outline-primary">
                        Voir le profil complet
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0"><i class="bi bi-car-front-fill me-2"></i>Véhicule Assigné</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="display-6 text-primary me-3"><i class="bi bi-info-square"></i></div>
                        <div>
                            <h4 class="mb-0 fw-bold">@Model.Car.Nickname</h4>
                            <small class="text-muted">@Model.Car.CarBrand @Model.Car.CarModel (@Model.Car.Year)</small>
                        </div>
                    </div>
                    <hr />
                    <a asp-controller="Car" asp-action="Details" asp-route-id="@Model.Car.Id" class="btn btn-sm btn-outline-primary">
                        Fiche technique auto
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-light py-3">
            <h5 class="mb-0 fw-bold text-secondary"><i class="bi bi-clock-history me-2"></i>Chronologie du dossier</h5>
        </div>
        <div class="card-body py-4">
            <div class="row text-center">
                <div class="col-md-4">
                    <label class="text-muted small d-block mb-1 text-uppercase fw-bold">Départ</label>
                    <div class="fs-5 fw-bold">@Model.Opening.ToString("dd MMM yyyy")</div>
                    <div class="small">@Model.Opening.ToString("HH:mm")</div>
                </div>
                <div class="col-md-4 border-start border-end">
                    <label class="text-muted small d-block mb-1 text-uppercase fw-bold">Retour Prévu</label>
                    <div class="fs-5 fw-bold text-primary">@Model.PlanedClosing.ToString("dd MMM yyyy")</div>
                    <div class="small text-primary">@Model.PlanedClosing.ToString("HH:mm")</div>
                </div>
                <div class="col-md-4">
                    <label class="text-muted small d-block mb-1 text-uppercase fw-bold">Retour Réel</label>
                    @if (Model.OfficialClosing.HasValue)
                    {
                        <div class="fs-5 fw-bold text-success">@Model.OfficialClosing.Value.ToString("dd MMM yyyy")</div>
                        <div class="small text-success">@Model.OfficialClosing.Value.ToString("HH:mm")</div>
                    }
                    else
                    {
                        <div class="fs-5 fw-bold text-danger italic">En cours...</div>
                        <div class="small badge bg-danger-subtle text-danger mt-1">
                            Durée : @((DateTime.Now - Model.Opening).Days) jours
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour aux dossiers
        </a>
    </div>
</div>