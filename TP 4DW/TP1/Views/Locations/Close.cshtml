@model TP1.Models.Locations.LocationDelete

@{
    ViewData["Title"] = "Fermer une location";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white py-3">
                    <h4 class="mb-0">
                        <i class="bi bi-check2-circle me-2"></i>Retour du véhicule — @ViewBag.CarNickname
                    </h4>
                    <small class="opacity-75">Conducteur : @ViewBag.DriverName</small>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Close" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="LocationId" />
                        <input type="hidden" asp-for="Opening" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="OfficialClosing" class="form-label fw-semibold">
                                Date et heure réelle de retour <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input asp-for="OfficialClosing" type="datetime-local" class="form-control"
                                       id="officialClosingInput" />
                                <button type="button" class="btn btn-outline-secondary"
                                        onclick="document.getElementById('officialClosingInput').value = new Date(new Date().getTime() - new Date().getTimezoneOffset()*60000).toISOString().slice(0,16)">
                                    <i class="bi bi-clock me-1"></i>Maintenant
                                </button>
                            </div>
                            <span asp-validation-for="OfficialClosing" class="text-danger"></span>
                            <div class="form-text text-muted">
                                Ouverture : @Model.Opening.ToString("dd MMM yyyy HH:mm")
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Note" class="form-label fw-semibold">Note de fermeture (optionnel)</label>
                            <textarea asp-for="Note" class="form-control" rows="3"
                                      placeholder="État du véhicule au retour, observations..."></textarea>
                            <span asp-validation-for="Note" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-3">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Annuler
                            </a>
                            <button type="submit" class="btn btn-success px-4 shadow-sm">
                                <i class="bi bi-check2-circle me-1"></i> Confirmer le retour
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
