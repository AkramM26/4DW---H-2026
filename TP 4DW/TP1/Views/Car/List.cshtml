@model IEnumerable<LocationManageCore.Domains.Car>

@{
    ViewData["Title"] = "Inventaire des véhicules";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-car-front-fill me-2"></i>Gestion de la flotte</h2>
            <p class="text-muted mb-0">Liste des véhicules pour la succursale sélectionnée</p>
        </div>
        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
        {
            <a asp-action="Create" asp-route-branchId="@Model.First().BranchId" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Nouveau véhicule
            </a>
        }
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="ps-4">@Html.DisplayNameFor(model => model.Nickname)</th>
                            <th>Marque & Modèle</th>
                            <th>Immatriculation</th>
                            <th>Statut</th>
                            <th>Disponibilité</th>
                            <th class="text-center px-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-primary">@item.Nickname</div>
                                    <small class="text-muted">NIV: @item.SerialNumber</small>
                                </td>

                                <td>
                                    <div class="fw-bold">@item.CarBrand</div>
                                    <div class="small text-muted">@item.CarModel (@item.Year)</div>
                                </td>

                                <td>
                                    <span class="badge bg-light text-dark border font-monospace">@item.Registration</span>
                                </td>

                                <td>
                                    <span class="badge rounded-pill @(item.Status == "Actif" ? "bg-success" : "bg-warning text-dark")">
                                        <i class="bi @(item.Status == "Actif" ? "bi-check-circle" : "bi-exclamation-triangle") me-1"></i>
                                        @item.Status
                                    </span>
                                </td>

                                <td>
                                    @if (item.Availability)
                                    {
                                        <span class="text-success small fw-bold"><i class="bi bi-circle-fill me-1 small"></i> En stock</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger small fw-bold"><i class="bi bi-circle-fill me-1 small"></i> En location</span>
                                    }
                                </td>

                                <td class="text-center px-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white shadow-sm d-flex align-items-center justify-content-center" style="min-width: 40px;">
                                            <i class="bi bi-search"></i>
                                        </a>

                                        <a asp-action="Transfer" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-dark shadow-sm d-flex align-items-center justify-content-center" style="min-width: 40px;">
                                            <i class="bi bi-truck"></i>
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@item.Id" asp-route-branchId="@item.BranchId" class="btn btn-sm btn-primary shadow-sm d-flex align-items-center justify-content-center" style="min-width: 40px;">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-controller="Branch" asp-action="List" class="btn btn-link text-decoration-none text-secondary p-0">
            <i class="bi bi-arrow-left"></i> Retour aux succursales
        </a>
    </div>
</div>