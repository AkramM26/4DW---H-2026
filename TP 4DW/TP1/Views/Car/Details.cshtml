@model LocationManageCore.Domains.Car

@{
    ViewData["Title"] = "Détails du véhicule";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Fiche du véhicule : <span class="text-primary">@Model.Nickname</span></h1>
        <div>
            @* <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Modifier</a> *@
            <a asp-action="List" asp-route-branchId="@Model.BranchId" class="btn btn-outline-secondary">Retour à la liste</a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-5">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Spécifications techniques</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Marque/Modèle</dt>
                        <dd class="col-sm-7">@Model.CarBrand @Model.CarModel (@Model.Year)</dd>

                        <dt class="col-sm-5">NIV</dt>
                        <dd class="col-sm-7 text-monospace">@Model.SerialNumber</dd>

                        <dt class="col-sm-5">Plaque</dt>
                        <dd class="col-sm-7">@Model.Registration</dd>

                        <dt class="col-sm-5">Kilométrage</dt>
                        <dd class="col-sm-7">@Model.Mileage km</dd>

                        <dt class="col-sm-5">Valeur estimée</dt>
                        <dd class="col-sm-7">@Model.EstimatedValue?.ToString("C")</dd>

                        <dt class="col-sm-5">État mécanique</dt>
                        <dd class="col-sm-7">
                            @if (Model.State)
                            {
                                <span class="text-success"><i class="bi bi-check-circle"></i> Bon</span>
                            }
                            else
                            {
                                <span class="text-danger"><i class="bi bi-exclamation-triangle"></i> Nécessite entretien</span>
                            }
                        </dd>

                        <dt class="col-sm-5">Statut</dt>
                        <dd class="col-sm-7">
                            <span class="badge @(Model.Status == "Actif" ? "bg-success" : "bg-warning")">@Model.Status</span>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Historique des locataires</h5>
                </div>
                <div class="card-body">
                    @if (Model.Locations != null && Model.Locations.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>Date début</th>
                                        <th>Conducteur</th>
                                        <th>Statut</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var loc in Model.Locations.OrderByDescending(l => l.Opening))
                                    {
                                        var duree = loc.OfficialClosing.HasValue
                                            ? (loc.OfficialClosing.Value - loc.Opening).Days
                                            : (DateTime.Now - loc.Opening).Days;

                                        <tr>
                                            <td>@loc.Opening.ToShortDateString()</td>
                                            <td>@(loc.Driver != null ? $"{loc.Driver.FirstName} {loc.Driver.LastName}" : "N/A")</td>
                                            <td>
                                                @if (loc.OfficialClosing == null)
                                                {
                                                    <span class="badge bg-info text-dark">En cours (@duree jours)</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Terminée (@duree jours)</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-controller="Locations" asp-action="Details" asp-route-id="@loc.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">Aucun historique de location pour ce véhicule.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* Section Notes *@
    <div class="card shadow-sm border-0 mt-2">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0"><i class="bi bi-sticky-fill me-2"></i>Notes du véhicule</h5>
            <a asp-action="AddNote" asp-route-id="@Model.Id" class="btn btn-dark btn-sm">
                <i class="bi bi-plus-lg me-1"></i> Ajouter une note
            </a>
        </div>
        <div class="card-body">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle-fill me-1"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (Model.Notes != null && Model.Notes.Any())
            {
                <ul class="list-group list-group-flush">
                    @foreach (var note in Model.Notes.OrderByDescending(n => n.CreatedAt))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-start">
                            <div>
                                <p class="mb-1">@note.Content</p>
                                <small class="text-muted"><i class="bi bi-clock me-1"></i>@note.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="alert alert-light border mb-0">
                    <i class="bi bi-info-circle me-1"></i> Aucune note pour ce véhicule.
                </div>
            }
        </div>
    </div>
</div>