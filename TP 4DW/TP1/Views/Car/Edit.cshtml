@model TP1.Models.Cars.CarEdit

@{
    ViewData["Title"] = "Modifier le véhicule";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Modifier le véhicule : <span class="text-primary">@Model.Nickname</span></h1>
        <a asp-action="List" asp-route-branchId="@ViewBag.BranchId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="BranchId" />

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <h5 class="border-bottom pb-2 mb-3"><i class="bi bi-info-circle"></i> Identification</h5>
                        <div class="mb-3">
                            <label asp-for="Nickname" class="form-label">Surnom / Code interne</label>
                            <input asp-for="Nickname" class="form-control" placeholder="ex: MTL-001" />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CarBrand" class="form-label">Marque</label>
                                <input asp-for="CarBrand" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="CarModel" class="form-label">Modèle</label>
                                <input asp-for="CarModel" class="form-control" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Year" class="form-label">Année</label>
                                <input asp-for="Year" class="form-control" type="number" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Color" class="form-label">Couleur</label>
                                <input asp-for="Color" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6 mb-4">
                        <h5 class="border-bottom pb-2 mb-3"><i class="bi bi-gear"></i> Statut et État</h5>
                        
                        <div class="mb-4">
                            <label asp-for="Status" class="form-label fw-bold text-danger">Statut de gestion</label>
                            <select asp-for="Status" class="form-select border-danger">
                                <option value="Actif">Actif (En service)</option>
                                <option value="Désactivé">Désactivé (Prêt pour archivage)</option>
                            </select>
                            <small class="text-muted">Un véhicule doit être "Désactivé" pour être archivé.</small>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="Availability" class="form-check-input" type="checkbox" role="switch">
                                <label asp-for="Availability" class="form-check-label">Disponible pour location</label>
                            </div>

                            <div class="form-check form-switch mb-3">
                                <input asp-for="State" class="form-check-input" type="checkbox" role="switch">
                                    <label asp-for="State" class="form-check-label">Bon état mécanique</label>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Mileage" class="form-label">Kilométrage (km)</label>
                                    <input asp-for="Mileage" class="form-control" type="number" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SerialNumber" class="form-label">Numéro de série (NIV)</label>
                            <input asp-for="SerialNumber" class="form-control" />
                            <span asp-validation-for="SerialNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Registration" class="form-label">Immatriculation</label>
                            <input asp-for="Registration" class="form-control" />
                            <span asp-validation-for="Registration" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <button type="submit" class="btn btn-primary btn-lg px-5">
                                <i class="bi bi-check-lg"></i> Enregistrer
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @section Scripts {
            @{
                await Html.RenderPartialAsync("_ValidationScriptsPartial");
            }
        }