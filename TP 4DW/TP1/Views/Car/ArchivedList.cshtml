@model IEnumerable<TP1.Models.Cars.CarItem>

@{
    ViewData["Title"] = "Véhicules Archivés";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1><i class="bi bi-archive text-secondary"></i> Véhicules Archivés</h1>
        <a asp-action="ListAll" class="btn btn-primary">Retour à l'inventaire complet</a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Surnom</th>
                        <th>Marque / Modèle</th>
                        <th>Plaque</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">Aucun véhicule n'est actuellement archivé.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.Nickname</strong></td>
                            <td>@item.CarBrand @item.CarModel (@item.Year)</td>
                            <td><span class="badge bg-light text-dark border">@item.Registration</span></td>
                            <td class="text-center">
                                <form asp-action="Restore" method="post" onsubmit="return confirm('Voulez-vous restaurer ce véhicule dans l\'inventaire ?');">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="bi bi-arrow-counterclockwise"></i> Restaurer
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>