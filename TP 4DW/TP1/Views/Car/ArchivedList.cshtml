@model IEnumerable<TP1.Models.Cars.CarItem>

@{
    ViewData["Title"] = "Véhicules Archivés";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold mb-0 text-secondary">
                <i class="bi bi-archive-fill me-2"></i>Véhicules Archivés
            </h2>
            <p class="text-muted mb-0">Historique des véhicules retirés de la flotte active</p>
        </div>
        <a asp-action="ListAll" class="btn btn-outline-primary shadow-sm">
            <i class="bi bi-arrow-left"></i> Retour à l'inventaire
        </a>
    </div>

    <div class="card shadow-sm border-0 bg-light">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-secondary text-dark">
                        <tr>
                            <th class="ps-4 py-3">Véhicule</th>
                            <th>Spécifications</th>
                            <th>Immatriculation</th>
                            <th class="text-center px-4">Récupération</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="bi bi-info-circle fs-2 d-block mb-2"></i>
                                        Aucun véhicule n'est actuellement archivé.
                                    </div>
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr class="opacity-75">
                                <td class="ps-4">
                                    <div class="fw-bold">@item.Nickname</div>
                                    <small class="text-muted">ID: @item.Id.ToString().Substring(0, 8)</small>
                                </td>
                                <td>
                                    <div>@item.CarBrand @item.CarModel</div>
                                    <div class="small text-muted">Année : @item.Year</div>
                                </td>
                                <td>
                                    <span class="badge bg-white text-dark border">@item.Registration</span>
                                </td>
                                <td class="text-center px-4">
                                    <form asp-action="Restore" method="post" onsubmit="return confirm('Voulez-vous restaurer ce véhicule dans l\'inventaire actif ?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-success px-3 shadow-sm">
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> Restaurer
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-4 border-0 shadow-sm">
        <i class="bi bi-shield-lock-fill me-2"></i>
        <strong>Note :</strong> La restauration d'un véhicule le remettra automatiquement dans sa succursale d'origine avec le statut <strong>Désactivé</strong>.
    </div>
</div>