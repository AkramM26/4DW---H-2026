@model TP1.Models.Cars.CarCreate

@{
    ViewData["Title"] = "Ajouter un véhicule";
}7

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h3 class="card-title mb-0"><i class="bi bi-plus-circle me-2"></i>Nouveau Véhicule</h3>
                </div>
                
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <input type="hidden" asp-for="BranchId" />
                            <div class="col-md-6 border-end">
                                <h5 class="text-secondary mb-3 border-bottom pb-2">Identification</h5>
                                <div class="mb-3">
                                    <label asp-for="Nickname" class="form-label font-weight-bold">Surnom du véhicule</label>
                                    <input asp-for="Nickname" class="form-control" placeholder="Ex: La Flèche" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="SerialNumber" class="form-label">NIV (Serial Number)</label>
                                    <input asp-for="SerialNumber" class="form-control" />
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Registration" class="form-label">Plaque d'immatriculation</label>
                                    <input asp-for="Registration" class="form-control" placeholder="X00 XXX" />
                                </div>
                                <div class="row mt-4">
                                    <div class="col">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" asp-for="Status" />
                                            <label class="form-check-label" asp-for="Status">Actif</label>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" asp-for="Availability" />
                                            <label class="form-check-label" asp-for="Availability">Disponible</label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6 ps-4">
                                <h5 class="text-secondary mb-3 border-bottom pb-2">Spécifications techniques</h5>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="CarBrand" class="form-label">Marque</label>
                                        <input asp-for="CarBrand" class="form-control" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="CarModel" class="form-label">Modèle</label>
                                        <input asp-for="CarModel" class="form-control" />
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Year" class="form-label">Année</label>
                                        <input asp-for="Year" class="form-control" />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="Color" class="form-label">Couleur</label>
                                        <input asp-for="Color" class="form-control" />
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="Mileage" class="form-label">Kilométrage</label>
                                    <div class="input-group">
                                        <input asp-for="Mileage" class="form-control" />
                                        <span class="input-group-text">km</span>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="EstimatedValue" class="form-label">Valeur estimée</label>
                                    <div class="input-group">
                                        <input asp-for="EstimatedValue" class="form-control" />
                                        <span class="input-group-text">$</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <div class="mb-3">
                            <label asp-for="InitialNote" class="form-label text-secondary">
                                <i class="bi bi-sticky me-1"></i> Note initiale <span class="text-muted fw-normal">(optionnel)</span>
                            </label>
                            <textarea asp-for="InitialNote" class="form-control" rows="3"
                                      placeholder="État du véhicule, observations à la création..."></textarea>
                            <span asp-validation-for="InitialNote" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="List" asp-route-branchId="@Model.BranchId" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Annuler
                            </a>
                            <button type="submit" class="btn btn-primary px-5 shadow-sm">
                                <i class="bi bi-check-circle me-1"></i> Créer le véhicule
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>